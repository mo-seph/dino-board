	(text "Hold BOOT, tap RESET: ROM loader\non USB. Only needed if the\nfirmware is badly broken."
		(exclude_from_sim no)
		(at 350.52 63.5 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "67a8d194-b417-565f-8272-33e6341c7a38")
	)
	(text "U6 (TLV803S, open drain) holds EN low while 3V3 is under 2.93 V, so a flat cell can take the\ncharger's 21 mA trickle instead of the module eating it. U6 also gives the 200 ms start-up delay.\nR16 is 100k to keep the held-off drain low; R32 limits the current when U6 discharges C32."
		(exclude_from_sim no)
		(at 266.7 85.09 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "90266776-7e54-5c6a-9163-d05bdbc61ab1")
	)
