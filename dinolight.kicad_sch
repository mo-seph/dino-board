	(text "SW1: 2-1 joined = on; 2-3 = off (3 is open)"
		(exclude_from_sim no)
		(at 20.32 226.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1a668ec5-c894-5622-a503-e8c5572abbb7")
	)
	(text "SW1 on: LDO_EN = battery, regulator runs. SW1 carries no load current.\nUSB plugged in: D23, R4 / R5 put about 2.2 V on LDO_EN whatever SW1 says, so it can\nshow charging and be programmed. Otherwise off: U3 shut down (0.01 uA typ),\nLED rail off. D23 stops the battery feeding back onto VBUS through R4.\nU3 is an XC6220B331: 0.2 ohm pass transistor (60 mV dropout at 300 mA), 8 uA quiescent."
		(exclude_from_sim no)
		(at 17.78 248.92 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "f5b4077c-6fcc-52a7-afd3-1d533db1a295")
	)
